# Azure (Variant B, self-hosted) - TEMPLATE ONLY, nothing here has been deployed yet.
# All endpoints are private IPs / private DNS inside the customer VNet. No public model APIs.
PRIVRAG_ENV=azure
PRIVRAG_LOG_LEVEL=INFO

# Stage 1 - layout-aware parsing (Docling models pre-downloaded to tenant storage)
PRIVRAG_PARSER_BACKEND=docling

# Stage 2 - BGE-M3 served by Hugging Face TEI (or vLLM) on the GPU node, OpenAI-compatible API
PRIVRAG_EMBED_BACKEND=remote
PRIVRAG_EMBED_URL=http://<embed-private-ip>:8080/v1
PRIVRAG_EMBED_MODEL=BAAI/bge-m3

# Qdrant server (container) inside the VNet
PRIVRAG_QDRANT_MODE=server
PRIVRAG_QDRANT_URL=http://<qdrant-private-ip>:6333
# PRIVRAG_QDRANT_API_KEY= (from Key Vault)

# Stage 3 - reranker (TEI /rerank) and LLM (vLLM, OpenAI-compatible)
PRIVRAG_RERANK_BACKEND=remote
PRIVRAG_RERANK_URL=http://<rerank-private-ip>:8081
PRIVRAG_MIN_RELEVANCE=-4.0        # tune on the eval set: below this best rerank logit -> "not in corpus"
PRIVRAG_LLM_BACKEND=openai
PRIVRAG_LLM_BASE_URL=http://<vllm-private-ip>:8000/v1
PRIVRAG_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
PRIVRAG_LLM_TIMEOUT_S=120
PRIVRAG_LLM_MAX_RETRIES=2

# Stage 4 - audit trail in PostgreSQL (open source) and API protection
PRIVRAG_AUDIT_DB_URL=postgresql+psycopg://<user>:<password>@<pg-private-host>:5432/audit
# PRIVRAG_API_KEY= (from Key Vault)
PRIVRAG_CORS_ORIGINS=["https://<frontend-host>"]

# Benchmark cost model: price of the GPU VM per hour (EUR)
PRIVRAG_GPU_HOUR_COST=3.67
