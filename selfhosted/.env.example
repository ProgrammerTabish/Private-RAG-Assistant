# Local development (default): stand-in models, no GPU, no downloads.
# Copy to .env and adjust. Every setting is PRIVRAG_<NAME> (see src/privrag/config.py).
PRIVRAG_ENV=local
PRIVRAG_LOG_LEVEL=INFO

PRIVRAG_PARSER_BACKEND=pymupdf     # docling on Azure
PRIVRAG_EMBED_BACKEND=lsa          # bge-m3 or remote on Azure
PRIVRAG_RERANK_BACKEND=none        # cross-encoder or remote on Azure
PRIVRAG_LLM_BACKEND=fake           # openai (= vLLM) on Azure
PRIVRAG_QDRANT_MODE=path           # server on Azure

PRIVRAG_CHUNK_SIZE=1400
PRIVRAG_CHUNK_OVERLAP=200
PRIVRAG_TOP_K=8
PRIVRAG_CANDIDATE_K=40
PRIVRAG_MIN_CITATIONS=2
