# Copy to .env and adjust. Only the LLM settings are required.

# ---- LLM (outside the stack, any OpenAI-compatible /v1 endpoint) ----------------------
# vLLM on an Azure GPU VM in the same VNet:   http://10.0.1.4:8000/v1
# Ollama on the Docker host:                  http://host.docker.internal:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=            # only if the endpoint needs one

# ---- optional --------------------------------------------------------------------------
# API_PORT=8000
# EMBED_URL=http://embeddings:80/v1          # or an external TEI/vLLM embedding endpoint
# EMBED_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.7   # GPU image

# Everything below is passed to the pipeline as-is (see selfhosted/src/privrag/config.py)
PRIVRAG_TOP_K=8
PRIVRAG_QUERY_REWRITE=true
PRIVRAG_LLM_TIMEOUT_S=120
PRIVRAG_LLM_MAX_TOKENS=900
PRIVRAG_EMBED_BATCH_SIZE=16
PRIVRAG_EMBED_TIMEOUT_S=300
# PRIVRAG_API_KEY=                            # require X-API-Key on /ask, /audit, ...
# PRIVRAG_AUDIT_DB_URL=postgresql+psycopg://user:pass@host:5432/audit   # default: SQLite on the volume
# PRIVRAG_RERANK_BACKEND=remote
# PRIVRAG_RERANK_URL=http://reranker:80
